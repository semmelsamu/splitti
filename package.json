{
  "name": "splitti",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Selbst gehostete Kostenaufteilungs-App für WGs",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node scripts/start.mjs",
    "check": "astro check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "astro build && playwright test",
    "test:all": "npm run lint && npm run check && npm run test && npm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "ocr:report": "tsx scripts/ocr-report.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "@astrojs/react": "^7.1.8",
    "astro": "^7.4.11",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
